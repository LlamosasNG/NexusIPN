# Docker Compose
NGINX_PORT=80
VITE_API_URL=/api

# Local PostgreSQL container
POSTGRES_DB=nexus_ipn
POSTGRES_USER=nexus_app
# If a secret contains $, wrap the value in single quotes or escape each $ as $$.
POSTGRES_PASSWORD=replace-with-a-long-random-db-password

# Backend
NODE_ENV=production
PORT=4000
FRONTEND_URL=http://localhost
# Optional comma-separated list for additional allowed origins.
FRONTEND_URLS=
# If a secret contains $, wrap the value in single quotes or escape each $ as $$.
JWT_SECRET=replace-with-a-long-random-secret

# Backend database connection.
# Docker Compose builds this value for the api service from POSTGRES_* variables.
# Keep this only for running scripts outside Compose.
DATABASE_URL=postgresql://nexus_app:replace-with-a-long-random-db-password@localhost:5432/nexus_ipn
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Mail
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=replace@example.com
EMAIL_PASSWORD=replace-with-mail-password

# Optional private user seed source.
# SEED_USERS_FILE=/run/secrets/users.seed.json
# SEED_USERS_JSON_BASE64=
# SEED_USERS_JSON=
